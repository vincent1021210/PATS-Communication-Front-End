# 複製成 .env 後再改
# cp .env.example .env

# DuckDNS（或任何指向這台公網 IP 的網域），不要加 https://
DOMAIN=pats-call.duckdns.org

# GitHub Pages 網址（CORS）
CORS_ORIGIN=https://vincent1021210.github.io

# Oracle 主機公網 IP（填進 turnserver.conf 的 external-ip）
PUBLIC_IP=x.x.x.x

# TURN 帳密（會出現在前端，請自訂一組）
TURN_USER=pats
TURN_PASS=please-change-this-password
