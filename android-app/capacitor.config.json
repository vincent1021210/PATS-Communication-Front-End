{
  "appId": "tw.pats.chat",
  "appName": "PATS",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#f5f7fb"
  },
  "ios": {
    "backgroundColor": "#f5f7fb",
    "contentInset": "never"
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "updateUrl": "",
      "statsUrl": "",
      "channelUrl": "",
      "appReadyTimeout": 10000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "resetWhenUpdate": true
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": false,
        "facebook": false,
        "twitter": false
      },
      "logLevel": 1
    }
  }
}
